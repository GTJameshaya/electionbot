# Токен бота от @BotFather (обязательно; нужен и админ-панели — для проверки подписи Telegram)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ID группы, куда отправляется ведомость (обязательно, для супергрупп начинается с -100)
GROUP_CHAT_ID=-1001234567890

# Тег, который ставится в начале подписи к файлу
TARGET_BOT_TAG=@supp0rt_dom

# База данных (необязательно). По умолчанию SQLite-файл data/electionbot.db рядом с ботом.
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@host:5432/electionbot
#             (нужно доустановить драйвер: pip install "psycopg[binary]")
DATABASE_URL=sqlite:///data/electionbot.db

# ---- Доступ (Telegram user_id через запятую) ----
# Администраторы: бот + админ-панель (кнопка «🛠 Админ-панель», /admin)
ADMIN_USER_IDS=111111111,222222222
# Обычные пользователи бота (без админки)
ALLOWED_USER_IDS=333333333
# Остальным доступ закрыт. Если оба списка пусты и в БД нет ролей — бот отказывает всем (ошибка в логе).
# Роли из .env применяются к тем, кого ещё не меняли в админке; дальше роли меняются в панели.

# ---- Админ-панель (python admin.py) ----
# Внешний адрес панели. Для кнопки Mini App в Telegram нужен https://
ADMIN_PUBLIC_URL=https://admin.example.org
# Секрет для подписи cookie, минимум 32 символа:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=
# Где слушает панель (наружу — через nginx с HTTPS)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
# Необязательно: username бота без @ — включает Telegram Login Widget на /login (нужен /setdomain в @BotFather)
ADMIN_BOT_USERNAME=
